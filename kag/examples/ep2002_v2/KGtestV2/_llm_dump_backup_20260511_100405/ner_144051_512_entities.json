[
  {
    "category": "EightDReport",
    "name": "EP2002阀二级调节器压力超差故障分析报告",
    "properties": {
      "reportNo": "600812585",
      "issueTitle": "EP2002阀二级调节器压力超差故障",
      "ownerName": "王怀亮",
      "ownerRole": "项目经理",
      "d2ProblemStatement": "2022/8/19，深圳地铁14号线 T030 车在中车长客库内静调时首次上电自检失败，制动系统报 “secondary regulator out of range（二级调节器压力超差）” 故障。截至报告编写时，该问题共发生 5 起。故障都发生在调试阶段首次自检过程中。",
      "d4RootCauseSummary": "塑料活塞销存在气孔导致其强度变弱，活塞销在内部弹簧作用下与阀座接触并持续受力，最终发生变形，导致进气口闭合时受到的弹簧应力变小，二级调节器实际压力降低，出现二级调节器压力超差故障。",
      "d5PermanentCorrectionSummary": "供应商库存活塞销100%外观检，EP2002阀出货前增加二级调节器压力检测项点，供应商更新活塞销生产模具及排气改善方案。",
      "d7PreventionSummary": "TBD",
      "reportStatus": "纠正措施验证和最终会议为 TBD，报告未完全关闭"
    }
  },
